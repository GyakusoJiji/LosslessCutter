<Window x:Class="LosslessCutter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LosslessCutter"
        mc:Ignorable="d"
        Title="LosslessCutter" Height="580" Width="720"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="200"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Video Preview with Drag & Drop -->
        <Border Grid.Row="0" BorderBrush="#666" BorderThickness="1"
                Background="#1A1A1A" AllowDrop="True"
                Drop="MovieImage_Drop" DragOver="MovieImage_DragOver"
                MouseLeftButtonDown="MovieArea_MouseLeftButtonDown"
                MouseWheel="MovieArea_MouseWheel"
                Cursor="Hand">
            <Grid>
                <MediaElement x:Name="MovieImage" Stretch="Uniform"
                              LoadedBehavior="Manual" ScrubbingEnabled="True"
                              MediaOpened="MovieImage_MediaOpened"
                              MediaEnded="MovieImage_MediaEnded"
                              MediaFailed="MovieImage_MediaFailed"/>
                <TextBlock x:Name="txtDropHint"
                           Text="MP4 ファイルをここにドロップ"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#888" FontSize="18" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Row 1: File Info -->
        <TextBlock Grid.Row="1" x:Name="txtFileInfo"
                   Margin="0,5,0,2" Foreground="#555" FontSize="11"
                   Text="ファイルが読み込まれていません"/>

        <!-- Row 2: Timeline Slider -->
        <Slider Grid.Row="2" x:Name="sldTimeline"
                Minimum="0" Maximum="100" Value="0"
                IsEnabled="False"
                ValueChanged="sldTimeline_ValueChanged"
                Margin="0,2"/>

        <!-- Row 3: Slice Locations Canvas (visual timeline) -->
        <Canvas Grid.Row="3" x:Name="SliceCanvas"
                Background="#DDDDDD" Margin="0,4"
                SizeChanged="SliceCanvas_SizeChanged"
                MouseLeftButtonDown="SliceCanvas_MouseLeftButtonDown"/>

        <!-- Row 4: Slice Info -->
        <TextBlock Grid.Row="4" x:Name="txtSliceInfo"
                   Margin="0,4" Foreground="#555" FontSize="11"
                   Text="スライスポイント: なし"/>

        <!-- Row 5: Action Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,2">
            <Button x:Name="btnConvert" Content="Lossless Cut" Width="120"
                    Margin="0,0,10,0" Click="btnConvert_Click" IsEnabled="False"/>
            <Button x:Name="btnSlice" Content="Slice" Width="80"
                    Margin="0,0,10,0" Click="btnSlice_Click" IsEnabled="False"/>
            <Button x:Name="btnReset" Content="Reset" Width="80"
                    Click="btnReset_Click" IsEnabled="False"/>
        </StackPanel>

        <!-- Row 6: Status Bar -->
        <Border Grid.Row="6" Background="#F5F5F5" Margin="0,6,0,0"
                Padding="6,3" BorderBrush="#DDD" BorderThickness="1">
            <TextBlock x:Name="txtStatus" Text="準備完了" FontSize="11"/>
        </Border>
    </Grid>
</Window>
